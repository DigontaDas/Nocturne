# Nocturne Infrastructure & Application Environment
POSTGRES_USER=nocturne
POSTGRES_PASSWORD=nocturne_secret
POSTGRES_DB=nocturne
POSTGRES_PORT=5433
REDIS_PORT=6379

DATABASE_URL=postgresql+asyncpg://nocturne:nocturne_secret@localhost:5433/nocturne
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3300","http://127.0.0.1:3300"]

# Phase 4 AI Concierge — Free Llama Provider Configuration (do NOT commit real keys here; use .env or Railway/Vercel Variables)
# Option 1 (Recommended — Free Tier): Set GROQ_API_KEY from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Option 2 (Free OpenAI-compatible Llama endpoints e.g. OpenRouter :free, Cerebras, GitHub Models)
LLAMA_API_KEY=
LLAMA_BASE_URL=
LLAMA_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Option 3 (100% Free Local Ollama running Llama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Frontend URL (used by payment gateways for return/callback URLs)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3300
TABLE_DEPOSIT_BDT=1000
FREE_CANCELLATION_HOURS=4
NO_SHOW_GRACE_MINUTES=15

# Early Payment — bKash Tokenized Checkout (Sandbox defaults from developer.bka.sh / Clarity)
BKASH_GRANT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/token/grant
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Early Payment — Card Checkout (Stripe Secret Key e.g. sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=bdt

# Allow local sandbox payment simulation badge when gateway credentials are unset
PAYMENT_ALLOW_DEMO_SIMULATION=true
