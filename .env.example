# Nocturne Infrastructure & Application Environment
POSTGRES_USER=nocturne
POSTGRES_PASSWORD=nocturne_secret
POSTGRES_DB=nocturne
POSTGRES_PORT=5433
REDIS_PORT=6379

DATABASE_URL=postgresql+asyncpg://nocturne:nocturne_secret@localhost:5433/nocturne
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3300","http://127.0.0.1:3300"]

# Phase 4 AI Concierge (optional; falls back cleanly to local deterministic/Ollama mode if unset)
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
